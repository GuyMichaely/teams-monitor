{
  "//": "Copied automatically to the gitignored config/config.json on first run. Keep secrets out of this file.",
  "pollIntervalMs": 15000,
  "whitelist": {
    "autoSend": []
  },
  "holdMessage": "Thanks — I've seen this and will get back to you shortly.",
  "brain": {
    "provider": "gemini",
    "model": "gemini-3.1-flash-lite",
    "apiKeyEnv": "GEMINI_API_KEY"
  },
  "gui": {
    "port": 8090,
    "host": "127.0.0.1",
    "authTokenEnv": "GUI_TOKEN"
  },
  "alerts": {
    "notifyAll": false,
    "transport": "websocket",
    "websocketUrl": "",
    "fcm": {
      "serviceAccountFile": "config/fcm-service-account.json"
    },
    "ignoreAuthors": [],
    "mentionNames": []
  },
  "integrations": {
    "tfs": {
      "enabled": false,
      "serverPort": 8080,
      "authTokenEnv": "TFS_AGENT_TOKEN",
      "resultTimeoutMs": 120000,
      "longPollMaxMs": 30000
    }
  },
  "debug": {
    "echoLoop": false
  },
  "automation": {
    "mode": "alert-only"
  }
}
