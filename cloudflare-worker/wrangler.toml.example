name = "teams-monitor-control"
main = "src/index.js"
compatibility_date = "2026-08-28"

[[durable_objects.bindings]]
name = "CONTROL"
class_name = "ControlState"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["ControlState"]

# Configure these as Wrangler secrets, not vars:
#   CONTROL_TOKEN           same value used by GUI_TOKEN on PC/phone
#   FIREBASE_PROJECT_ID
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
