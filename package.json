{
  "name": "teams-automation",
  "version": "0.1.0",
  "description": "Automate reading and sending Microsoft Teams messages via the Chrome DevTools Protocol on the new (WebView2) Teams client.",
  "type": "module",
  "bin": {
    "teams": "src/cli.mjs"
  },
  "scripts": {
    "start": "node --env-file=.env src/cli.mjs run",
    "gui": "node --env-file=.env src/cli.mjs gui",
    "read": "node --env-file=.env src/cli.mjs read",
    "send": "node --env-file=.env src/cli.mjs send",
    "watch": "node --env-file=.env src/cli.mjs watch"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
