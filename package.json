{
  "name": "teams-automation",
  "version": "0.1.0",
  "description": "Automate reading and sending Microsoft Teams messages via the Chrome DevTools Protocol on the new (WebView2) Teams client.",
  "type": "module",
  "bin": {
    "teams": "src/cli.mjs"
  },
  "scripts": {
    "test:agent-sdk": "bun --no-env-file scripts/smoke-agent-sdk.mjs",
    "test:agent-nvidia": "bun --no-env-file scripts/smoke-agent-nvidia.mjs",
    "test:agent-storage": "bun --no-env-file scripts/smoke-agent-storage.mjs",
    "test:agent-intake": "bun --no-env-file scripts/smoke-agent-intake.mjs",
    "test:agent-policy": "bun --no-env-file scripts/smoke-agent-policy.mjs",
    "test:agent-continuity": "bun --no-env-file scripts/smoke-agent-continuity.mjs",
    "test:agent-conversations": "bun --no-env-file scripts/smoke-agent-conversations.mjs",
    "desktop:setup-switching": "bun --no-env-file scripts/setup-switching.mjs",
    "test:desktop-switching": "bun --no-env-file scripts/smoke-desktop-switching.mjs",
    "test:policy-conversion": "bun --no-env-file scripts/smoke-policy-conversion.mjs",
    "desktop:install": "powershell.exe -NoProfile -File scripts/install-desktop.ps1",
    "desktop": "powershell.exe -NoProfile -File scripts/start-desktop.ps1",
    "start": "bun --env-file=.env src/cli.mjs run",
    "gui": "bun --env-file=.env scripts/gui-supervisor.mjs start",
    "gui:direct": "bun --env-file=.env src/cli.mjs gui",
    "gui:status": "bun --env-file=.env scripts/gui-supervisor.mjs status",
    "gui:stop": "bun --env-file=.env scripts/gui-supervisor.mjs stop",
    "read": "bun --env-file=.env src/cli.mjs read",
    "send": "bun --env-file=.env src/cli.mjs send",
    "watch": "bun --env-file=.env src/cli.mjs watch"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "dependencies": {
    "@openai/agents": "0.18.0",
    "zod": "4.6.5"
  }
}
