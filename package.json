{
  "name": "teams-automation",
  "version": "0.1.0",
  "description": "Automate reading and sending Microsoft Teams messages via the Chrome DevTools Protocol on the new (WebView2) Teams client.",
  "type": "module",
  "bin": {
    "teams": "src/cli.mjs"
  },
  "scripts": {
    "start": "bun --env-file=.env src/cli.mjs run",
    "gui": "bun --env-file=.env src/cli.mjs gui",
    "read": "bun --env-file=.env src/cli.mjs read",
    "send": "bun --env-file=.env src/cli.mjs send",
    "watch": "bun --env-file=.env src/cli.mjs watch"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true
}
