<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dnd_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#D32F2F"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dnd_warning"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/dnd_fix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dnd_fix" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <Button
                android:id="@+id/toggle_alarm_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/toggle_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="64dp"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/toggle_screen_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="64dp"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/conn_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/last_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#11000000"
                android:padding="12dp" />

            <Button
                android:id="@+id/btn_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/open_dashboard" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_settings" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_battery" />

            <Button
                android:id="@+id/btn_test_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/test_alarm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/diagnostics_title"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/diagnostics_window"
                android:text="@string/diagnostics_window_label" />
            <Spinner
                android:id="@+id/diagnostics_window"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/diagnostics_windows" />
            <Button
                android:id="@+id/diagnostics_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_from_label"
                android:visibility="gone"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/diagnostics_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_to_label"
                android:visibility="gone"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/diagnostics_category"
                android:text="@string/diagnostics_category_label" />
            <Spinner
                android:id="@+id/diagnostics_category"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/diagnostics_categories" />
            <EditText
                android:id="@+id/diagnostics_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="text"
                android:maxLength="200"
                android:singleLine="true"
                android:hint="@string/diagnostics_search_hint" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_export_note" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_copy_diagnostics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy_diagnostics"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/btn_share_diagnostics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/share_diagnostics"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
